# Public client configuration only. Never put a Supabase service_role key here.
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...) from Supabase → Project Settings → API.
# VITE_SUPABASE_ANON_KEY is accepted as a fallback for legacy JWT anon keys.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Keep AI gateway credentials on the server/deployment secret store only.
LOVABLE_API_KEY=
